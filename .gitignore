# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# local analysis job snapshots (dev resume)
.breakitfirst-jobs/

# BIF_TRACE=1 raw pass dumps (contain idea text + full model output; local only)
.breakitfirst-traces/

# S6 anonymous hinge feedback (no idea text, but still user input — local only)
.breakitfirst-feedback/

# third-party agent skills / tools (local only — do not push)
.vendor/
.agents/
.agent-native/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (do not commit real secrets)
.env*
!.env.example
!eval/env.example

# eval baseline & stability runs (raw model output; keep folder via .gitkeep)
eval/baselines/*
!eval/baselines/.gitkeep
eval/stability/*
!eval/stability/.gitkeep
eval/locale-flip/*
!eval/locale-flip/.gitkeep
# N1b specificity reports quote SPOF prose + idea anchors — local only
eval/specificity/*
!eval/specificity/.gitkeep
# K8 repro output holds the generated idea text + captured POST bodies — local only
eval/input-repro/*
!eval/input-repro/.gitkeep

# Python caches & virtual environments
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
.pytest_cache/

# vercel
.vercel

# obsidian
.obsidian

# Modal & cloud artifacts
.modal/

# OS & IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# typescript
*.tsbuildinfo
next-env.d.ts
