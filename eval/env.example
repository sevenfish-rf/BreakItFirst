# Copy values into your shell — do not commit real keys.
# PowerShell:
#   $env:BIF_BASE_URL="https://api.openai.com/v1"
#   $env:BIF_API_KEY="sk-..."
#   $env:BIF_PASS1_MODEL="gpt-4o"
#   $env:BIF_PASS2_MODEL="gpt-4o-mini"
#   npm run eval:baseline

BIF_BASE_URL=https://api.openai.com/v1
BIF_API_KEY=
BIF_PASS1_MODEL=
BIF_PASS2_MODEL=

# Optional
# BIF_LOCALE=en
# BIF_ONLY=01-marketplace-pet-sitting
# BIF_DEEP=1

# Dump the raw prose of every pass to .breakitfirst-traces/ (local only).
# Pass 1 generates 3 SPOF candidates internally and reports keep only the
# winner; this is the only way to see the two that were discarded. Files
# contain the idea text and full model output, so leave it off on any shared
# host. Gitignored.
# BIF_TRACE=1
