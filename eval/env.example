# Provider configuration (OpenAI-compatible endpoint — Modal, vLLM, anything).
# This file is COMMITTED: placeholders only, never a real endpoint or key.
# PowerShell:
#   $env:BIF_BASE_URL="https://<your-endpoint-host>/v1"
#   $env:BIF_API_KEY="<your-key>"
#   $env:BIF_PASS1_MODEL="<model-id>"
#   $env:BIF_PASS2_MODEL="<model-id>"
#   npm run eval:baseline

BIF_BASE_URL=
BIF_API_KEY=
BIF_PASS1_MODEL=
BIF_PASS2_MODEL=

# eval/smoke-test-kimi.ts only (measured cost per call on a Modal endpoint).
# Modal wants the key and secret as separate headers, so it reads these two
# instead of BIF_API_KEY. No defaults: it exits 2 if either is unset.
# MODAL_KEY=
# MODAL_SECRET=

# Optional
# BIF_LOCALE=en
# BIF_ONLY=01-marketplace-pet-sitting
# BIF_DEEP=1

# Stability run only (npm run eval:stability).
# BIF_KINDS limits which rewrites run — default is every kind on disk
# (para = full paraphrase, strip = proper nouns/places removed,
# flip = same facts in reversed order). BIF_REF diffs SPOF labels against an
# earlier baseline folder. BIF_STABILITY_GATE makes the run exit non-zero when
# any rewrite lands on a disjoint theme, so it can be wired into CI.
# BIF_KINDS=para,strip,flip
# BIF_REF=2026-07-16_230859
# BIF_STABILITY_GATE=1

# Locale-flip run only (npm run eval:locale-flip). Same idea, en vs id, mode
# held constant. BIF_LOCALE_GATE makes the run exit non-zero if any fixture's
# bands move between locales.
# BIF_LOCALE_GATE=1

# Browser input repro only (npm run eval:input-repro). Zero provider calls:
# it drives a real Chromium at a running app and aborts its own POST.
# BIF_APP_URL must point at a build you control (npx next start -p 3010), not
# at a stale dev server — an un-hydrated page is rejected, not reported.
# BIF_APP_URL=http://127.0.0.1:3010/app
# BIF_REPRO_CHARS=6000
# BIF_REPRO_WRAP=72
# BIF_REPRO_SCENARIOS=paste,type,type-loaded
# BIF_REPRO_TYPE_TIMEOUT_MS=360000
# BIF_REPRO_GATE=1

# Dump the raw prose of every pass to .breakitfirst-traces/ (local only).
# Pass 1 generates 3 SPOF candidates internally and reports keep only the
# winner; this is the only way to see the two that were discarded. Files
# contain the idea text and full model output, so leave it off on any shared
# host. Gitignored.
# BIF_TRACE=1
